# Copy to .env, fill only what you need, then run:
#   chmod 600 .env
# Values already present in the shell environment take precedence.
# Test runs never load this file, and values are never printed or committed.

# Optional chat reasoning (one provider is enough)
GROQ_API_KEY=
GOOGLE_AI_API_KEY=
# GEMINI_API_KEY=

# Local runtime settings
SPARKIEE_PORT=2005
SPARKIEE_TTS_SPEED=1.0

# Optional project registry override
# SPARKIEE_PROJECTS_FILE=/absolute/path/to/projects.json

# Set to 1 to disable .env loading entirely
# SPARKIEE_DISABLE_DOTENV=1
